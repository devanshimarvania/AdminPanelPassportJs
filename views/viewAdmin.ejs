                <div class="col-lg-12 grid-margin stretch-card">
                    <div class="card">
                        <div class="card-body">
                            <h4 class="card-title">Admins</h4>
                            <% if(admins.length> 0){ %>
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th> Sr. No </th>
                                            <th> Profile </th>
                                            <th> Name </th>
                                            <th> Email </th>
                                            <th> Gender </th>
                                            <th> DOB </th>
                                            <th> Role </th>
                                            <th> City </th>
                                            <th> Action </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% admins.map((admin, i)=> { %>
                                            <tr>
                                                <td>
                                                    <%= i+1 %>
                                                </td>
                                                <td>
                                                    <img src="<%= admin.avtar %>" width="100">
                                                </td>
                                                <td>
                                                    <%= admin.name %>
                                                </td>
                                                <td>
                                                    <%= admin.email %>
                                                </td>
                                                <td>
                                                    <%= admin.gender %>
                                                </td>
                                                <td>
                                                    <%= admin.dob %>
                                                </td>
                                                <td>
                                                    <%= admin.role %>
                                                </td>
                                                <td>
                                                    <%= admin.city %>
                                                </td>
                                                <td>
                                                    <a href="/deleteAdmin/<%= admin._id %>"
                                                        class="btn btn-danger">Delete</a>
                                                    <!-- <br> -->
                                                    <a href="/editAdmin/<%= admin._id %>"
                                                        class="btn btn-warning">Edit</a>
                                                </td>
                                            </tr>
                                            <% }) %>

                                    </tbody>
                                </table>
                            <% } else { %>
                                <div class="text-center mt-5 noAdmin">
                                    <h4 class="mb-4">No Admin added yet.</h4>
                                    <a href="/addAdmin" class="mt-5">Add one now!</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
